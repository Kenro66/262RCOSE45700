# 配置模板。复制为 backend/.env 后填写真实值；.env 不提交。
# 系统环境变量优先于此文件；更换模型或服务时只修改本地 .env。

# 数据库（王诗琪）
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/p4rag

# 嵌入模型（孙忠其）：NPU 可用前本地 CPU 跑 bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
# CPU 模式必须留空；远程 NPU 协议尚未接入，非空会明确报错。
EMBEDDING_BASE_URL=
# 预留字段，当前 CPU 适配器不读取、不发送该密钥。
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY

# 生成模型（孙忠其）：必须支持工具调用（P18），候选 EXAONE 4.0 或 Qwen 3，最终模型等 NPU 确认
GENERATION_MODEL=
# 填写 OpenAI-compatible API 根地址，不附加 /chat/completions。
GENERATION_BASE_URL=
# 仅为占位符。真实值只填本地 .env；无鉴权服务可留空。
GENERATION_API_KEY=YOUR_GENERATION_API_KEY
GENERATION_TIMEOUT_SECONDS=60

# Blank embedding base URL selects local CPU inference.
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=8192
# Optional cache location, for example D:/RAG-Dev/models/huggingface/hub.
EMBEDDING_CACHE_DIR=
EMBEDDING_CPU_THREADS=1
