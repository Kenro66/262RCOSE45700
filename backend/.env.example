# 配置模板。复制为 backend/.env 后填写真实值；.env 不提交。
# 系统环境变量优先于此文件；更换模型或服务时只修改本地 .env。

# 数据库（王诗琪）
# 与 docker-compose.yml 的对应：用户名固定 rag（POSTGRES_USER）、库名固定 p4rag
# （POSTGRES_DB）、端口 127.0.0.1:5432；DATABASE_URL 里的密码必须与下面
# POSTGRES_PASSWORD 相同。POSTGRES_PASSWORD 是 compose 必填项（未设置 compose
# 直接报错）。填写任意随机字符串（例如 32 位），真实值只写在本地 .env。
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rag:PASSWORD@localhost:5432/p4rag

# 嵌入模型（孙忠其）：NPU 可用前本地 CPU 运行 BGE-M3
EMBEDDING_MODEL=BAAI/bge-m3
# CPU 模式必须留空；远程 NPU 协议尚未接入，非空会明确报错。
EMBEDDING_BASE_URL=
# 预留字段，当前 CPU 适配器不读取、不发送该密钥。
EMBEDDING_API_KEY=

# 统一生成配置：Single / Agent / Answer Repair / 流程 Fallback 使用同一 Gemma。
# legacy 保留原 GENERATION_* / AGENT_GENERATION_* 配置；不是自动学校模型备用。
GENERATION_PROFILE=furiosa_gemma
# 只填写安全文件路径；文件中为 FURIOSA_API_KEY=...，不复制密钥到本模板。
# 空路径默认 backend/.secrets/furiosa.env；也可通过进程 FURIOSA_API_KEY 提供。
FURIOSA_API_KEY_FILE=
FURIOSA_GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_TOKENS=2048
GENERATION_TEMPERATURE=0.6

# legacy 档使用的原生成配置，切回时显式设置 GENERATION_PROFILE=legacy。
# Gemma 档固定使用 furiosa-ai/gemma-4-31B-it-FP8-block 及已确认的 Furiosa /v1。
GENERATION_MODEL=
# 填写 OpenAI-compatible API 根地址，不附加 /chat/completions。
GENERATION_BASE_URL=
# 真实密钥仅填写在本地 .env；无鉴权服务可留空。
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=120

# legacy 档的 Agent 专用生成配置（显式启用；留空时沿用通用配置）。
# furiosa_gemma 档统一覆盖下列生成配置，不读取学校密钥，原始配置不改写。
# legacy 档的 Single RAG 及 #74 流程回退使用通用 GENERATION_*。
# 切换 Gemma 时同时填写 MODEL、BASE_URL 和其专用密钥，不继承学校密钥。
# 已确认候选：furiosa-ai/gemma-4-31B-it-FP8-block
AGENT_GENERATION_MODEL=
AGENT_GENERATION_BASE_URL=
AGENT_GENERATION_API_KEY=
AGENT_GENERATION_TIMEOUT_SECONDS=
AGENT_GENERATION_JSON_SCHEMA_ENABLED=false
AGENT_GENERATION_MAX_TOKENS=
AGENT_GENERATION_TEMPERATURE=

# 问答模式：未配置时默认 single，保持原 Single RAG 的 HTTP 行为。
# 只允许 single 或 agent；空值、其他拼写都会在创建应用时明确报错。
# agent 启用持久化问答、追问恢复、执行状态查询和主动取消。
# 修改后需重启后端。
RAG_MODE=single
# Agent 与受控 Single Fallback 共用的执行时限，默认 120 秒，须为正整数。
RAG_EXECUTION_TIMEOUT_SECONDS=120

# 嵌入模型参数
# EMBEDDING_BASE_URL 留空时使用本地 CPU 推理。
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=8192
# 可选模型缓存路径，例如 D:/RAG-Dev/models/huggingface/hub
EMBEDDING_CACHE_DIR=
EMBEDDING_CPU_THREADS=1

# 问题 #11：最小可用版本的默认检索数量，有效范围为 1 到 100。
RETRIEVAL_TOP_K=5

# 可选的年龄定义和枚举后续条款补全；初次检索的前五条结果保持不变。
# 团队于 2026-11-03 决定为演示和部署启用此功能（合并请求 #53）。
# 设置为 false 时仅使用初次检索结果；缺少此配置时默认关闭补全。
EVIDENCE_COMPLETION_ENABLED=true

