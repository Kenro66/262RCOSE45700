# 配置模板。复制为 backend/.env 后填写真实值；.env 不提交。

# 数据库（王诗琪，Issue #4；默认值与 docker-compose.yml 一致）
# 任选一个随机密码（例如 32 位随机串），两处都要填且必须一致
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rag:填同一个密码@127.0.0.1:5432/p4rag

# 嵌入模型（孙忠其）：NPU 可用前本地 CPU 跑 bge-m3
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 生成模型（孙忠其）：必须支持工具调用（P18），候选 EXAONE 4.0 或 Qwen 3，最终模型等 NPU 确认
GENERATION_MODEL=
GENERATION_BASE_URL=
GENERATION_API_KEY=
