{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:chat": "node --test tests/chat.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vitest.config.ts --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "node scripts/coverage-runtime-lines.mjs --self-test && vitest run --coverage && node scripts/coverage-runtime-lines.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.2",
    "vite": "^8.0.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
