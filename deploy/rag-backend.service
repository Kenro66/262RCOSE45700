[Unit]
Description=Document RAG FastAPI backend
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/262RCOSE45700/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/262RCOSE45700/.venv/bin/python -m uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
